# Credentials — never commit
.env
.env.*
*.pem
*.key

# Model weights / checkpoints — never commit (see NOTICE.md)
*.pth
*.pt
*.ckpt
*.pth.tar
potential_saved_bestmodel
potential_saved_latest
params_Si
params_O
pca
scale_factor

# DFT proprietary/large
POTCAR
WAVECAR
CHG
CHGCAR
vasprun.xml

# Data / run outputs (instance-specific; keep templates and configs only)
*.extxyz
*.xyz
!examples/**/*.example.xyz
*.traj
*.dump
*.log
!examples/**/*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
build/
dist/
*.egg-info/

# Local overrides — never commit real credentials/paths
configs/*.local.yaml
.claude/settings.local.json

# Per-user run configs and generated run artifacts (real campaigns are never tracked;
# small test fixtures live under tests/fixtures/ and are tracked explicitly)
configs/runs/
runs/

# Development scratch (harness lives under tests/harness/; nothing else in work/ is tracked)
work/

# Generated stage-harness outputs (the committed inputs under tests/fixtures/ are kept)
tests/fixtures/stage_b_smoke/out/
tests/fixtures/stage_c_golden/out/
tests/fixtures/stage_d1_replay/out/

# Maintainer handoff guides are shared separately
MANUAL.md
MANUAL_KO.md
output/

# License decision is intentionally deferred by the maintainers
LICENSE
