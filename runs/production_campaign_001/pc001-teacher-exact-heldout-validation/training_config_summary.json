{
  "framework": "NequIP/Allegro (nequip 0.15.0 / allegro 0.7.1)",
  "cutoff_radius": 5.0,
  "chemical_symbols": [
    "O",
    "Si"
  ],
  "l_max": 2,
  "parity": true,
  "num_layers": 4,
  "num_scalar_features": 256,
  "num_tensor_features": 128,
