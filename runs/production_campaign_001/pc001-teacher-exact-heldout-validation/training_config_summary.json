  "loss": "EnergyForceLoss per_atom_energy=true; total_energy 1.0 + forces 1.0",
  "optimizer": "Adam lr 0.01; ReduceLROnPlateau; EMA decay 0.999; EarlyStopping patience 20",
  "batch_size": 4,
  "seed": 123,
  "energy_convention_note": "per_type shift = per_atom_energy_mean; evaluated via NequIPCalculator (valid path; NOT raw-torch total_energy / C3)"
