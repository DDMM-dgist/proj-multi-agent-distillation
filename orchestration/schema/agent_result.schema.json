{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "agent", "status", "summary", "artifacts",
    "evidence", "requested_approval", "next_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "needs_input", "blocked", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "requested_approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary", "reason"],
          "properties": {
            "boundary": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["role", "path"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "integrity": {"type": "object"}
      }
    }
  }
}
