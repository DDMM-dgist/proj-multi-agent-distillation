{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_task.schema.json",
  "title": "AgentTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "agent", "created_at", "instruction",
    "inputs", "criteria", "constraints", "context"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "criteria": {"$ref": "#/$defs/strings"},
    "constraints": {"$ref": "#/$defs/strings"},
    "context": {"type": "object"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reference": {
      "type": "object",
      "required": ["role", "path"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "integrity": {"type": "object"}
      }
    }
  }
}
